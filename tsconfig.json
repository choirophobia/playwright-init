{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "sourceMap": true,
    "noEmit": true
  },
  "include": [
    "pages/**/*.ts",
    "tests/**/*.ts",
    "features/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts"
  ]
}
